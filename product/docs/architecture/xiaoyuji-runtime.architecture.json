      "dot": "orange",
      "title": "当前主链路",
      "items": [
        "自动续听；明确告别本地结束并停止收音",
        "短答先播；绘图校验会话和基图后发布",
        "命中敏感规则后本地回应，跳过文本模型",
        "独立LiveKit实验；正式链路仍为半双工"
      ]
    },
    {
      "dot": "emerald",
      "title": "成长记录原则",
      "items": [
        "本轮证据单独归属；旧画面不自动附档",
        "补全核对片段修订；清空/恢复拒绝旧代次",
        "损坏先恢复；备用失败可见；JSON手动备份",
        "账号、多档案、跨设备云同步待接通"
      ]
    },
    {
      "dot": "orange",
      "title": "安全边界",
      "items": [
        "POST同源；文本上下文排除家长码与整库",
        "有限中文规则；ASR音频先到云端再检测",
        "无自动通知、敏感档案或历史全面脱敏",
        "图片质量与独立安全集、生产部署待验收"
      ]
    }
