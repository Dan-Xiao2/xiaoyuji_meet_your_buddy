    {
      "dot": "orange",
      "title": "当前主链路",
      "items": [
        "自动续听；明确告别本地结束并停止收音",
        "短答先播；绘图校验会话和基图后发布",
        "命中敏感规则后本地回应，跳过文本模型"
      ]
    },
    {
      "dot": "emerald",
      "title": "成长记录原则",
      "items": [
        "敏感求助不归档；操作催促不作成长证据",
        "补全核对片段修订；清空/恢复拒绝旧代次",
        "损坏先恢复；备用失败可见；JSON手动备份"
      ]
    },
    {
      "dot": "orange",
      "title": "安全边界",
      "items": [
        "私有文件不公开；POST同源与有界JSON",
        "有限中文规则；ASR音频先到云端再检测",
        "无自动通知、敏感档案或历史全面脱敏"
      ]
    },
    {
      "dot": "slate",
      "title": "未完成与待验收",
