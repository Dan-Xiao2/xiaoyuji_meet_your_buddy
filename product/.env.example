NODE_ENV=development
HOST=127.0.0.1
PORT=4173

# Alibaba Cloud Model Studio / Bailian (China Beijing example)
LLM_PROVIDER=qwen
QWEN_API_KEY=replace_me_with_your_bailian_api_key
QWEN_WORKSPACE_ID=replace_me_with_your_workspace_id
QWEN_BASE_URL=https://replace_me.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
TUTOR_ENABLE_LLM=false
TUTOR_ENABLE_LOCAL_FALLBACK=true
TUTOR_LLM_TIMEOUT_MS=18000
TUTOR_MAX_OUTPUT_TOKENS=900
TUTOR_ENABLE_THINKING=false
TUTOR_TEMPERATURE=0.7
TUTOR_QUICK_TIMEOUT_MS=3500
TUTOR_QUICK_MAX_OUTPUT_TOKENS=180

# Realtime PCM upload with local silence detection; batch ASR is the fallback
ASR_PROVIDER=qwen
ASR_REALTIME=true
QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_MODEL=qwen3-asr-flash
ASR_TIMEOUT_MS=18000
VOICE_RECORD_SECONDS=4
VOICE_LANGUAGE=zh-CN

# Cloud speech synthesis, with browser speech as automatic fallback
TTS_PROVIDER=qwen
USE_CLOUD_TTS=false
TTS_STREAMING=true
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_VOICE=longanhuan_v3.6
TTS_SPEAKING_RATE=0.88
TTS_TIMEOUT_MS=18000

# Opt-in paid image generation/editing. Uses the same QWEN_API_KEY and region.
# Keep disabled until account access, costs and generated-content checks are approved.
IMAGE_DRAWING_ENABLED=false
QWEN_IMAGE_MODEL=qwen-image-2.0
# Every generated image is held server-side until this vision review passes.
QWEN_IMAGE_REVIEW_MODEL=qwen3-vl-flash

# Privacy defaults for the MVP
REQUIRE_PARENT_CONSENT=true
STORE_RAW_AUDIO=false
STORE_TRANSCRIPTS=true
ALLOW_CHILD_PERSONAL_DATA=false

# Optional OpenAI ASR fallback. Leave empty when using Qwen ASR.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional real-model benchmark pricing. Keep these aligned with the account's
# current billing page; blank values are reported as unavailable, never zero.
BENCHMARK_CURRENCY=CNY
BENCHMARK_TEXT_INPUT_PER_MILLION=
BENCHMARK_TEXT_OUTPUT_PER_MILLION=
BENCHMARK_IMAGE_PER_CALL=
BENCHMARK_IMAGE_REVIEW_INPUT_PER_MILLION=
BENCHMARK_IMAGE_REVIEW_OUTPUT_PER_MILLION=

# Isolated local voice experiment. npm run voice:lab supplies local development credentials.
# Default launch uses synthetic providers; --live explicitly selects the existing QWEN_* services.
VOICE_LAB_ENABLED=false
VOICE_LAB_PROVIDER=synthetic
VOICE_LAB_PORT=4217
VOICE_AGENT_PORT=8087
# LIVEKIT_SERVER_BIN=/absolute/path/to/livekit-server
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
