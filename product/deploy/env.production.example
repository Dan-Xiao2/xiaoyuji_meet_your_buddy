# The server's .env (/opt/xiaoyuji/product/.env, owner root:xiaoyuji, mode 640). Copy this file there
# and fill in the blanks on the server; never put the filled file in git or send it to anyone.
NODE_ENV=production

# Public server mode: listen on this machine only, behind Caddy (deploy/Caddyfile.example).
PUBLIC_MODE=true
TRUST_PROXY=true
HOST=127.0.0.1
PORT=4173

# One access code per family, and the secret that signs their sessions. Make both with:
#   node deploy/new-secrets.mjs F1 F2 F3
# Changing or removing a family's code (then restarting) signs that family out; changing the secret
# signs everyone out.
ACCESS_CODES=
SESSION_SECRET=
# How long a phone stays paired (720 hours = 30 days).
ACCESS_SESSION_HOURS=720

# Alibaba Cloud Model Studio / Bailian, China mainland (Beijing). Fill in the API key yourself.
LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
QWEN_QUICK_MODEL=qwen3.8-max
TUTOR_ENABLE_LLM=true
TUTOR_ENABLE_LOCAL_FALLBACK=true
TUTOR_LLM_TIMEOUT_MS=18000
TUTOR_MAX_OUTPUT_TOKENS=900
TUTOR_ENABLE_THINKING=false
TUTOR_TEMPERATURE=0.7
TUTOR_QUICK_TIMEOUT_MS=3500
TUTOR_QUICK_MAX_OUTPUT_TOKENS=180

ASR_PROVIDER=qwen
ASR_REALTIME=true
QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_MODEL=qwen3-asr-flash
ASR_TIMEOUT_MS=18000
VOICE_LANGUAGE=zh-CN

TTS_PROVIDER=qwen
USE_CLOUD_TTS=true
TTS_STREAMING=true
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_VOICE=longanhuan_v3.6
TTS_SPEAKING_RATE=0.88
TTS_TIMEOUT_MS=18000

# Cloud picture generation stays off for the pilot (docs/pilot-handbook.md).
IMAGE_DRAWING_ENABLED=false

# Privacy defaults.
REQUIRE_PARENT_CONSENT=true
STORE_RAW_AUDIO=false
STORE_TRANSCRIPTS=true
ALLOW_CHILD_PERSONAL_DATA=false

# Daily limits per family (server/usageLimits.mjs); a family over a limit gets "daily-limit" until
# midnight China time. Recognition connections open at once, for the whole server.
USAGE_DAILY_REPLIES=300
USAGE_DAILY_EXTRACTIONS=300
USAGE_DAILY_SPEECH=600
USAGE_DAILY_TRANSCRIPTIONS=300
USAGE_DAILY_DRAWINGS=100
USAGE_DAILY_IMAGES=20
USAGE_DAILY_ASR_SECONDS=3600
USAGE_ASR_CONNECTIONS=2
ASR_MAX_CONNECTIONS=12

# Not used on the public server: call mode and the voice lab stay off.
VOICE_LAB_ENABLED=false
